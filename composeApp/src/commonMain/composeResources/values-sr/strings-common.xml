    <string name="Settings_AnonymousCredentials_Label">Anonimni pristupni podaci</string>
    <string name="Settings_AnonymousCredentials_Description">Anonimni pristupni podaci omogućavaju platformi OONI da potvrdi autentičnost objavljenih merenja bez potrebe za kreiranjem naloga ili otkrivanjem vašeg identiteta.</string>
